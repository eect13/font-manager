# Copy to .env or export in your shell. Defaults work for local use.

KEEP_PORT=4747
KEEP_HOST=0.0.0.0

# Folder for the SQLite database and file blobs
KEEP_DATA=./data

# Change this. Sessions and share tokens are signed with it.
KEEP_SECRET=change-me-to-a-long-random-string

# First-run admin. Ignored once a user already exists.
KEEP_ADMIN_EMAIL=eect13@gmail.com
KEEP_ADMIN_PASSWORD=keep-change-me
KEEP_ADMIN_NAME=Eric

# Soft quota in gigabytes (0 = unlimited)
KEEP_QUOTA_GB=50

# Public URL used inside share links (leave blank to use the request host)
KEEP_PUBLIC_URL=http://127.0.0.1:4747
